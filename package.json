{
  "name": "field-commander",
  "version": "4.0.0",
  "description": "Field Commander v4.0 - Sovereign AR Verification Platform with Blockchain-anchored DTA",
  "private": true,
  "workspaces": [
    "mobile-app",
    "web-client",
    "backend",
    "blockchain"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=mobile-app",
    "web": "npm run start --workspace=web-client",
    "backend": "npm run dev --workspace=backend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "build:android": "npm run build:android --workspace=mobile-app",
    "build:ios": "npm run build:ios --workspace=mobile-app",
    "deploy:contract": "npm run deploy:contract --workspace=blockchain",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "husky": "^9.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "npm": {
    "legacy-peer-deps": true
  }
}
