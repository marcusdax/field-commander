{
  "name": "field-commander",
  "version": "4.0.0",
  "description": "Field Commander v4.0 - Sovereign AR Verification Platform with Blockchain-anchored DTA",
  "private": true,
  "workspaces": [
    "mobile-app",
    "web-client",
    "backend",
    "blockchain",
    "edge-substrate"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=mobile-app",
    "web": "npm run start --workspace=web-client",
    "backend": "npm run dev --workspace=backend",
    "edge": "npm run dev --workspace=edge-substrate",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:seed": "npm run seed:hotlist --workspace=backend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:android": "npm run build:android --workspace=mobile-app",
    "build:ios": "npm run build:ios --workspace=mobile-app",
    "build:web": "npm run build --workspace=web-client",
    "build:contracts": "npm run compile --workspace=blockchain",
    "deploy:contract:amoy": "npm run deploy:amoy --workspace=blockchain",
    "e2e:local": "npm run e2e:local --workspace=blockchain"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "husky": "^9.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "legacy-peer-deps": true
}
