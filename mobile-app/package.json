{
  "name": "mobile-app",
  "version": "4.0.0",
  "description": "Field Commander v4.0 - Sovereign AR Verification Platform",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "jest",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "xcodebuild -workspace ios/FieldCommander.xcworkspace -scheme FieldCommander -archivePath build/FieldCommander.xcarchive -sdk iphoneos archive",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.0",
    "react-native-webrtc": "^124.0.0",
    "@react-native-community/netinfo": "^11.3.0",
    "@react-native-community/geolocation": "^3.2.0",
    "react-native-tor": "^0.6.0",
    "react-native-crystals": "^1.0.0",
    "react-native-vision-camera": "^4.0.0",
    "react-native-arkit": "^6.0.0",
    "react-native-arcore": "^1.0.0",
    "react-native-gl-model-view": "^1.8.0",
    "react-native-sensors": "^7.3.0",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "i18next": "^23.7.0",
    "react-i18next": "^14.0.0",
    "expo-localization": "^15.0.0",
    "ethers": "^6.10.0",
    "zustand": "^4.4.0",
    "socket.io-client": "^4.7.0",
    "mqtt": "^5.3.0",
    "react-native-reanimated": "^3.6.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "react-native-safe-area-context": "^4.8.0",
    "react-native-screens": "^3.29.0",
    "react-native-gesture-handler": "^2.14.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "typescript": "^4.9.5",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "jest": "^29.7.0"
  }
}
