{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "jsx": "react",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "types": ["react", "react-native", "jest"]
  },
  "include": ["src/**/*", "index.js"],
  "exclude": ["node_modules", "build", "dist"],
  "compilerOptions.typeRoots": ["./node_modules/@types", "./node_modules/@react-native/types"]
}
