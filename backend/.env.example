# Field Commander Backend
PORT=3001
CORS_ORIGIN=*
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=field_commander
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Odasi AI microservices (leave blank to use mock)
ODASI_MOCK=true
ODASI_NADE_URL=
ODASI_GIE_URL=
ODASI_BNE_URL=

# Polygon / Blockchain
CHAIN_MOCK=true
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
BACKEND_SIGNER_KEY=
EVIDENCE_LEDGER_ADDRESS=

# DTA (CitizenLedgerDTA)
DTA_MOCK=true
DTA_CONTRACT_ADDRESS=
VERIFIER_PRIVATE_KEY=

# Edge Substrate integration
EDGE_SUBSTRATE_URL=http://localhost:3002
