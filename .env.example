# ──────────────────────────────────────────────────────────────────────────
# Field Commander — NVIN / InsightLPR Integration
# Copy to .env and fill in real values before running.
# NEVER commit the real .env file.
# ──────────────────────────────────────────────────────────────────────────

# ─── NVIN / InsightLPR / Odasi ─────────────────────────────────────────────
NVIN_API_URL=https://api.nvin.network/v1
NVIN_API_KEY=your_nvin_api_key_here
ODASI_NADE_URL=https://odasi.nvin.network/nade
ODASI_GIE_URL=https://odasi.nvin.network/gie
ODASI_BNE_URL=https://odasi.nvin.network/bne

# ─── Blockchain (Polygon) ──────────────────────────────────────────────────
POLYGON_RPC_URL=https://polygon-rpc.com
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
PRIVATE_KEY=0x_your_deployer_private_key
VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000

# ─── OCR Engine ─────────────────────────────────────────────────────────────────
OCR_MODEL_PATH=./models/ocr_v1.tflite
OCR_CONFIDENCE_THRESHOLD=0.85
OCR_GPU_DELEGATE=true

# ─── Ghost Mode ────────────────────────────────────────────────────────────────
TOR_SOCKS_PORT=9050
I2P_SAM_PORT=7656

# ─── LuminNode ─────────────────────────────────────────────────────────────────
LUMINNODE_BLE_UUID=6E400001-B5A3-F393-E0A9-E50E24DCCA9E
LUMINNODE_WIFI_SSID=LuminNet_Secure
LUMINNODE_WIFI_PASSWORD=your_wifi_password

# ─── Backend ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://localhost:5432/field_commander
